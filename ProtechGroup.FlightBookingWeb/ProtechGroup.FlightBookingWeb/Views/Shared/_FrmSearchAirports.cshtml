<div class="modal-form-search">
    <form class="form-search" method="post">
        <div class="g-1 row" style="width: 100%">
            <div class="col-12">
                <div class="left-form row">
                    <div class="col-4 col-xl-5 col-lg-9 col-sm-12">
                        <div class="itinerary">
                            <input hidden type="radio" name="type" id="oneway" checked class="typeItinerary" value="1" />
                            <label for="oneway">Một chiều</label>
                            <input hidden type="radio" name="type" id="roundtrip" class="typeItinerary" value="2" />
                            <label for="roundtrip">Khứ hồi</label>
                            <!--<input hidden type="radio" name="type" id="multicity" class="typeItinerary" value="3" />
    <label for="multicity">Nhiều chặng</label>-->
                            <input type="text" hidden name="roundType" id="roundType" />
                        </div>
                    </div>  
                    <div class="col-3 col-xl-4 col-lg-12">
                        <div class="row">
                            <div class="col-6">
                                <select id="seatClass" name="seatClass" class="form-control">
                                    <option value="all">Tất cả hạng ghế</option>
                                    <option value="economy">Phổ thông</option>
                                    <option value="business">Thương gia</option>
                                    <option value="first">Hạng nhất</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <select id="airline" name="airline" class="form-control">
                                    <option value="all">Tất cả hãng bay</option>
                                    <option value="VJ">VietJet Air</option>
                                    <option value="VN">Vietnam Airlines</option>
                                    <option value="QH">Bamboo Airways</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="right-form row g-0">
                    <div class="row col-8 col-xl-12 item-route route-first">
                        <div class="action-head col-12 d-none">
                            <h2>Chặng 1</h2>
                        </div>
                        <div class="row g-1 col-6 col-lg-12 route-point">
                            <div class="col-6 col-lg-12" onclick="openModal2(1,1)">
                                <div class="point-start point box">
                                    <label class="row g-0">
                                        <div class="col-xl-12">
                                            <img src="~/Content/svg/search/plane.svg" alt="plane" />
                                            <span>Điểm đi</span>
                                        </div>
                                        <p id="start" data-position-box="1" data-position-item="1"
                                           class="col-xl-9 col-sm-12 point-route">
                                            Chọn Điểm đi
                                        </p>
                                        <input type="text" hidden name="departureAirport" id="departureAirport" />
                                    </label>
                                </div>
                                <span id="isErooDepartureAirport" class="lableErro" style="display:none"></span>
                            </div>
                            <div class="col-6 col-lg-12" onclick="openModal2(1,2)">
                                <div class="point-end point box">
                                    <label class="row g-0">
                                        <div class="col-xl-12">
                                            <img src="~/Content/svg/search/map.svg" alt="plane" />
                                            <span>Điểm đến</span>
                                        </div>
                                        <p data-position-box="1" data-position-item="2" class="col-xl-9 col-sm-12 point-route">
                                            Chọn điểm đến
                                        </p>
                                        <input type="text" hidden name="arrivalAirport" id="arrivalAirport" />
                                    </label>
                                </div>
                                <span id="isErooArrivalAirport" class="lableErro" style="display:none"></span>
                            </div>
                            <div class="iconRound">
                                <img src="~/Content/svg/search/oneRound.svg" alt="iconRound" class="icon-one" />
                                <img src="~/Content/svg/search/twoRound.svg" alt="iconRound" class="icon-two" />
                            </div>
                        </div>
                        <div class="row col-6 g-1 col-lg-12 date-search">
                            <div class="col-6 startDay col-sm-12">
                                <div class="point-start point box">
                                    <label class="row g-0">
                                        <div class="col-12">
                                            <img src="~/Content/svg/search/calender.svg" alt="plane" />
                                            <span>Ngày đi</span>
                                        </div>
                                        <input type="text" id="departureDate" name="departureDate" class="calendar-input col-12"
                                               placeholder="dd/mm/yyyy" />
                                    </label>
                                </div>
                                <span id="isErooDepartureDate" class="lableErro" style="display:none"></span>
                            </div>
                            <div class="col-6 dateEnd col-sm-12">
                                <div class="point-end point box">
                                    <label class="row g-0">
                                        <div>
                                            <img src="~/Content/svg/search/calender.svg" alt="plane" />
                                            <span>Ngày về</span>
                                        </div>
                                        <input id="returnDate" name="returnDate" type="text" class="col-12 calendar-input"
                                               placeholder="dd/mm/yyyy" />
                                    </label>
                                </div>
                                <span id="isErooReturnDate" class="lableErro" style="display:none"></span>
                            </div>
                        </div>
                    </div>
                    <div class="route-point box-submit-search col-4 col-xl-12">
                        <div class="row g-1">
                            <div class="row col-7 col-sm-12">
                                <div class="row col-12">
                                    <div class="col-12 member-box " onclick="openModal()">
                                        <div class="box">
                                            <label>
                                                <div>
                                                    <img src="~/Content/svg/search/plane.svg" alt="plane" />
                                                    <span>Hành khách</span>
                                                </div>
                                                <p id="value-member">
                                                    <span id="member1">1</span> Người lớn,
                                                    <span id="member2">0</span> Trẻ em,
                                                    <span id="member3">0</span> Em bé
                                                </p>
                                            </label>
                                        </div>
                                        <span id="isErooNumPax" class="lableErro" style="display:none"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row col-5 col-sm-12">
                                <div class="row col-12">
                                    <div class="col-12 member-box btn-search-box">
                                        <button type="button" class="btn-search" id="btn-search">Tìm Kiếm</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Modal -->

        <input type="number" class="count count1" value="1" id="nguoiLon" name="nguoiLon" hidden />
        <input type="number" class="count count2" value="0" id="treEm" name="treEm" hidden />
        <input type="number" class="count count3" value="0" id="emBe" name="emBe" hidden />
    </form>
</div>
<div class="modal-overlay" id="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span>HÀNH KHÁCH</span>
            <span class="close-btn" onclick="modal.style.display ='none'">X</span>
        </div>
        <div class="passenger-row">
            <div>
                <strong>NGƯỜI LỚN</strong><br />
                <small>Từ 12 tuổi</small>
            </div>
            <div class="counter">
                <span class="minus minus1">−</span>
                <span id="memberModal1">1</span>
                <span class="plus plus1">+</span>
            </div>
        </div>
        <div class="passenger-row">
            <div>
                <strong>TRẺ EM</strong><br />
                <small>Từ 2 đến 11 tuổi</small>
            </div>
            <div class="counter">
                <span class="minus minus2">−</span>
                <span id="memberModal2">0</span>
                <span class="plus plus2">+</span>
            </div>
        </div>
        <div class="passenger-row">
            <div>
                <strong>EM BÉ</strong><br />
                <small>Dưới 2 tuổi</small>
            </div>
            <div class="counter">
                <span class="minus minus3">−</span>
                <span id="memberModal3">0</span>
                <span class="plus plus3">+</span>
            </div>
        </div>
        <span class="btn-model" onclick="modal.style.display ='none'">Xác nhận</span>
    </div>
</div>
<div class="modal-overlay" id="modal2">
    <div class="modal-content">
        <div class="modal-header">
            <span>Chọn điểm đi</span>
            <span class="close-btn" onclick="modal2.style.display ='none'">X</span>
        </div>
        <div class="passenger-row">
            <div class="inputSearch">
                <label>
                    NHẬP THÀNH PHỐ HOẶC MÃ SÂN BAY
                    <div class="input">
                        <input type="text" id="airportInput" />
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                </label>
            </div>
        </div>
        <div class="passenger-row">
            <div class="list-items">
                <ul id="airportResults">
                    <li onclick="checkRoute(this,'HAN')">Hà Nội (HAN)</li>
                    <li onclick="checkRoute(this,'SGN')">Hồ Chí Minh (SGN)</li>
                    <li onclick="checkRoute(this,'DAD')">Đà Nẵng (DAD)</li>
                    <li onclick="checkRoute(this,'DIN')">Điện Biên Phủ (DIN)</li>
                    <li onclick="checkRoute(this,'HPH')">Hải Phòng (HPH)</li>
                    <li onclick="checkRoute(this,'THD')">Thanh Hóa (THD)</li>
                    <li onclick="checkRoute(this,'VII')">Vinh (VII)</li>
                    <li onclick="checkRoute(this,'VDH')">Quảng Bình (VDH)</li>
                    <li onclick="checkRoute(this,'VCA')">Cần Thơ (VCA)</li>
                    <li onclick="checkRoute(this,'VKG')">Kiên Giang (VKG)</li>
                    <li onclick="checkRoute(this,'VCL')">Quảng Nam (VCL)</li>
                    <li onclick="checkRoute(this,'HUI')">Huế (HUI)</li>
                    <li onclick="checkRoute(this,'PXU')">PleiKu (PXU)</li>
                    <li onclick="checkRoute(this,'TBB')">Phú Yên (TBB)</li>
                    <li onclick="checkRoute(this,'BMV')">Ban Mê Thuột (BMV)</li>
                    <li onclick="checkRoute(this,'CXR')">Nha Trang (CXR)</li>
                    <li onclick="checkRoute(this,'UIH')">Qui Nhơn (UIH)</li>
                    <li onclick="checkRoute(this,'DLI')">Đà Lạt (DLI)</li>
                    <li onclick="checkRoute(this,'CAH')">Cà Mau (CAH)</li>
                    <li onclick="checkRoute(this,'PQC')">Phú Quốc (PQC)</li>
                    <li onclick="checkRoute(this,'VCS')">Côn Đảo (VCS)</li>
                    <li onclick="checkRoute(this,'VDO')">Vân Đồn (VDO)</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/modules/searchflight.js"></script>
